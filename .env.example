NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_MAX_CONNECTION_POOL_SIZE=100
# Defaults to the repo ontology/ directory.
# MUON_ONTOLOGY_DIR=/absolute/path/to/ontology

# Chat provider. Any OpenAI-compatible endpoint with strict json_schema output works.
# Qwen on Model Studio (Singapore): base URL
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1 and model qwen3.8-flash.
# Local servers (vLLM, Ollama) accept any non-empty key.
MUON_LLM_BASE_URL=https://api.openai.com/v1
MUON_LLM_API_KEY=change-me
MUON_LLM_MODEL=change-me
# Seconds per request and retries on 429, 5xx and timeouts.
# MUON_LLM_TIMEOUT=600
# MUON_LLM_MAX_RETRIES=2

# Embedding provider. Leave DIMENSIONS unset for models that reject the parameter.
MUON_EMBEDDING_BASE_URL=https://api.openai.com/v1
MUON_EMBEDDING_API_KEY=change-me
MUON_EMBEDDING_MODEL=text-embedding-3-large
MUON_EMBEDDING_DIMENSIONS=1024
