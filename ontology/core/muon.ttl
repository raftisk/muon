@prefix mo:      <https://muon.dev/ns/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

<https://muon.dev/ns/core> a owl:Ontology ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Universe-agnostic shared vocabulary (mo:) for the muon multi-universe knowledge graph."@en .

#################################################################
#  0: Diegetic plane
#################################################################

mo:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    skos:definition "Root of the diegetic hierarchy: anything that exists inside a fictional universe."@en .

mo:Agent a owl:Class ;
    rdfs:subClassOf mo:Entity ;
    rdfs:label "Agent"@en ;
    skos:definition "An entity with agency: it can act, perceive, hold intent."@en .

mo:Location a owl:Class ;
    rdfs:subClassOf mo:Entity ;
    rdfs:label "Location"@en ;
    skos:definition "Any in-universe locale, region or container where entities exist or act."@en .

mo:Group a owl:Class ;
    rdfs:subClassOf mo:Entity ;
    rdfs:label "Group"@en ;
    skos:definition "A in-universe social collective."@en .

mo:Object a owl:Class ;
    rdfs:subClassOf mo:Entity ;
    rdfs:label "Object"@en ;
    skos:definition "A physical tangible object."@en .

mo:Event a owl:Class ;
    rdfs:subClassOf mo:Entity ;
    rdfs:label "Event"@en ;
    skos:definition "Any distinct event, process or action that happens in-universe."@en .

mo:Concept a owl:Class ;
    rdfs:subClassOf mo:Entity ;
    rdfs:label "Concept"@en ;
    skos:definition "Top-level category for in-world abstract entities or concepts: a system, classification, language, attribute, ability, or taxon."@en .

mo:TimePeriod a owl:Class ;
    rdfs:subClassOf mo:Entity ;
    rdfs:label "TimePeriod"@en ;
    skos:definition "Any in-universe span of time with distinct beginning and end."@en .

## 1: Agent subclasses ##

mo:Person a owl:Class ;
    rdfs:subClassOf mo:Agent ;
    rdfs:label "Person"@en ;
    skos:definition "An individual with sapience, moral agency, culture and sufficient reasoning capacity. Can include humans, humanoids or non-human sapient beings."@en .

mo:Creature a owl:Class ;
    rdfs:subClassOf mo:Agent ;
    owl:disjointWith mo:Person ;
    rdfs:label "Creature"@en ;
    skos:definition "A living agent with limited sapience or cognition, often bounded by instinct. Typically non-human."@en .

mo:Deity a owl:Class ;
    rdfs:subClassOf mo:Agent ;
    rdfs:label "Deity"@en ;
    skos:definition "A god-tier agent. Immortal or quasi-immortal, often associated with supernatural powers."@en .

## 1: Location subclasses ##

mo:World a owl:Class ;
    rdfs:subClassOf mo:Location ;
    rdfs:label "World"@en ;
    skos:definition "A planetary-scale location."@en .

mo:Region a owl:Class ;
    rdfs:subClassOf mo:Location ;
    rdfs:label "Region"@en ;
    skos:definition "A sub-world location: a country, state, or province."@en .

mo:GeoFeature a owl:Class ;
    rdfs:subClassOf mo:Location ;
    rdfs:label "Geographic Feature"@en ;
    skos:definition "Any natural geographic feature: a mountain, river, lake, cave, etc."@en .

mo:Settlement a owl:Class ;
    rdfs:subClassOf mo:Location ;
    rdfs:label "Settlement"@en ;
    skos:definition "Any inhabited location or area: a city, town, etc."@en .

mo:Structure a owl:Class ;s
    rdfs:subClassOf mo:Location ;
    rdfs:label "Structure"@en ;
    skos:definition "Any constructed location, typically with a defined enclosed shape or form: a building, monument, etc."@en .

mo:Route a owl:Class ;
    rdfs:subClassOf mo:Location ;
    rdfs:label "Route"@en ;
    skos:definition "Any path or route between locations."@en .

## 1: Group subclasses ##

mo:Organization a owl:Class ;
    rdfs:subClassOf mo:Group ;
    rdfs:label "Organization"@en ;
    skos:definition "A formalized group or institution with a defined structure and purpose."@en .

mo:Kin a owl:Class ;
    rdfs:subClassOf mo:Group ;
    rdfs:label "Kin"@en ;
    skos:definition "A family or clan."@en .

mo:Community a owl:Class ;
    rdfs:subClassOf mo:Group ;
    rdfs:label "Community"@en ;
    skos:definition "A whole people or population with shared identity or interests."@en .

mo:Party a owl:Class ;
    rdfs:subClassOf mo:Group ;
    rdfs:label "Party"@en ;
    skos:definition "A small ad-hoc band with a shared goal or purpose."@en .

mo:Collective a owl:Class ;
    rdfs:subClassOf mo:Group ;
    rdfs:label "Collective"@en ;
    skos:definition "A named group of individuals with minimal or zero formal structure."@en .

## 1: Concept subclasses ##

mo:Taxon a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "Taxon"@en ;
    skos:definition "Any in-universe classification of being that an agent instantiates, whether biological or constructed."@en .

mo:Language a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "Language"@en ;
    skos:definition "Any in-universe system of communication, spoken, written or signed, used by agents."@en .

mo:Power a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "Power"@en ;
    skos:definition "Any discrete, invocable capability or supernatural act."@en .

mo:System a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "System"@en ;
    skos:definition "An organized in-world framework of interrelated rules, principles, or mechanisms governing a domain; most often a power framework."@en .

#################################################################
#  0: Non-diegetic (Meta) plane
#################################################################

mo:Universe a owl:Class ;
    rdfs:label "Universe"@en ;
    skos:definition "A fictional universe or canon."@en ;
    rdfs:comment "Represents a fictional universe as a set of real-word works, not the Universe as diegetic entity."@en .

mo:Work a owl:Class ;
    rdfs:label "Work"@en ;
    skos:definition "A source work that establishes canon: a book, film, game, etc."@en .

mo:Chapter a owl:Class ;
    rdfs:label "Chapter"@en ;
    skos:definition "A structural subdivision of a Work: a book chapter, episode, etc."@en ;
    rdfs:comment "Distinct from TextChunk; Chapter is a stable, citable unit recognizable by the audience and creators."@en .

mo:TextChunk a owl:Class ;
    rdfs:label "TextChunk"@en ;
    skos:definition "A retrieval-sized unit of source text."@en ;
    rdfs:comment "The minimum unit of text that may describe in-universe entities."@en .

mo:Creator a owl:Class ;
    rdfs:label "Creator"@en ;
    skos:definition "A real-world person or collective that creates works."@en .

#################################################################
#  Core properties
#################################################################

mo:inUniverse a owl:ObjectProperty ;
    rdfs:range   mo:Universe ;
    rdfs:label   "inUniverse"@en ;
    skos:definition "Associates an entity (or meta item) with the universe it belongs to. In the Neo4j realization this is ALSO injected as a lowercase namespace label (e.g. :pkmn) for query performance."@en .

mo:text a owl:DatatypeProperty ;
    rdfs:domain  mo:TextChunk ;
    rdfs:range   xsd:string ;
    rdfs:label   "text"@en ;
    skos:definition "Verbatim text content of a chunk."@en .

mo:fromWork a owl:ObjectProperty ;
    rdfs:domain  mo:TextChunk ;
    rdfs:range   mo:Work ;
    rdfs:label   "fromWork"@en ;
    skos:definition "The work a chunk of text was sourced from."@en .
