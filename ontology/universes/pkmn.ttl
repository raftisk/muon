@prefix pkmn: <https://muon.dev/ns/pkmn#> .
@prefix mo: <https://muon.dev/ns/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://muon.dev/ns/pkmn> a owl:Ontology ;
    dcterms:title   "muon: Pokémon extension"@en ;
    owl:versionInfo "0.3.0" ;
    owl:imports     <https://muon.dev/ns/core> ;
    skos:definition    "Pokémon-universe extension of the muon core ontology."@en .

## Main Pokémon species class ##

pkmn:PokemonSpecies a owl:Class ;
    rdfs:subClassOf mo:Species ;
    rdfs:label "Pokémon species"@en ;
    skos:definition "A Pokémon species as registered in the National Pokédex."@en ;
    rdfs:comment "Not to be confused with an individual Pokémon, which is a mo:Creature. Individual Pokémon are instances of their species via mo:hasSpecies."@en .


## Species datatype properties ##
pkmn:pokedexNumber a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "pokedexNumber"@en ;
    skos:definition "National Pokédex number. Exactly one per species."@en .
pkmn:baseHp        a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "baseHp"@en .
pkmn:baseAttack    a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "baseAttack"@en .
pkmn:baseDefense   a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "baseDefense"@en .
pkmn:baseSpAttack  a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "baseSpAttack"@en .
pkmn:baseSpDefense a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "baseSpDefense"@en .
pkmn:baseSpeed     a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "baseSpeed"@en .
pkmn:height        a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:decimal ; rdfs:label "height"@en ; skos:definition "Height in metres."@en .
pkmn:weight        a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:decimal ; rdfs:label "weight"@en ; skos:definition "Weight in kilograms."@en .
pkmn:femaleRate    a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:decimal ; rdfs:label "femaleRate"@en ;
    skos:definition "Share of females, 0 to 1. Absent when the species is genderless."@en .
pkmn:isGenderless  a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:boolean ; rdfs:label "isGenderless"@en ; skos:definition "True when the species has no gender."@en .
pkmn:catchRate     a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "catchRate"@en .
pkmn:baseExpYield  a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "baseExpYield"@en .
pkmn:shape         a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:string  ; rdfs:label "shape"@en .
pkmn:isLegendary   a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:boolean ; rdfs:label "isLegendary"@en .
pkmn:isMythical    a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:boolean ; rdfs:label "isMythical"@en .
pkmn:isStarter     a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:boolean ; rdfs:label "isStarter"@en .
pkmn:isDefaultForm a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:boolean ; rdfs:label "isDefaultForm"@en .
pkmn:genus          a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:string  ; rdfs:label "genus"@en ;
    skos:definition "Pokédex category without the word Pokémon ('Mole' for Diglett)."@en .
pkmn:eggCycles      a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "eggCycles"@en ; skos:definition "Egg cycles to hatch."@en .
pkmn:baseFriendship a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:integer ; rdfs:label "baseFriendship"@en ; skos:definition "Friendship on capture."@en .
pkmn:growthRate     a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:string  ; rdfs:label "growthRate"@en ;
    skos:definition "Experience curve: erratic, fast, medium_fast, medium_slow, slow, fluctuating."@en .
pkmn:color          a owl:DatatypeProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range xsd:string  ; rdfs:label "color"@en ; skos:definition "Pokédex colour."@en .

## Species object properties ##

pkmn:yieldsEv a owl:ObjectProperty ;
    rdfs:domain pkmn:PokemonSpecies ;
    rdfs:range  pkmn:Stat ;
    rdfs:label  "yieldsEv"@en ;
    skos:definition "A stat that defeating this species trains. The amount is the Neo4j edge property amount (rung 1b)."@en .

pkmn:designedBy a owl:ObjectProperty ;
    rdfs:domain pkmn:PokemonSpecies ;
    rdfs:range  mo:Creator ;
    rdfs:label  "designedBy"@en ;
    skos:definition "The real-world person who designed a species."@en .

## Moves and types ##

pkmn:Type a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "Type"@en ;
    skos:definition "Any of the elemental types applied to Pokémon and their moves, which affect the power and effectiveness of moves in battles."@en .

pkmn:Move a owl:Class ;
    rdfs:subClassOf mo:Power ;
    rdfs:label "Move"@en ;
    skos:definition "An active, learnable battle move (Thunderbolt, Tackle)."@en .

pkmn:hasType a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( pkmn:PokemonSpecies pkmn:Move ) ] ;
    rdfs:range pkmn:Type ;
    rdfs:label "hasType"@en ;
    rdfs:comment "A species has one or two types; a move has exactly one."@en .

pkmn:primaryType a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:hasType ;
    rdfs:domain pkmn:PokemonSpecies ;
    rdfs:range  pkmn:Type ;
    rdfs:label  "primaryType"@en .

pkmn:secondaryType a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:hasType ;
    rdfs:domain pkmn:PokemonSpecies ;
    rdfs:range  pkmn:Type ;
    rdfs:label  "secondaryType"@en .

pkmn:effectiveAgainst a owl:ObjectProperty ;
    rdfs:domain pkmn:Type ;
    rdfs:range  pkmn:Type ;
    rdfs:label  "effectiveAgainst"@en ;
    skos:definition "Attacking-type effectiveness on a defending type. Multiplier is encoded in the sub-property, not on the edge."@en .

pkmn:superEffectiveAgainst a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:effectiveAgainst ;
    rdfs:label "superEffectiveAgainst"@en ;
    skos:definition "x2."@en .

pkmn:notVeryEffectiveAgainst a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:effectiveAgainst ;
    rdfs:label "notVeryEffectiveAgainst"@en ;
    skos:definition "x0.5."@en .

pkmn:noEffectAgainst a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:effectiveAgainst ;
    rdfs:label "noEffectAgainst"@en ;
    skos:definition "x0 (immunity)."@en .


#################################################################
#  Base stats
#################################################################

pkmn:Stat a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label   "Stat"@en ;
    skos:definition "A battle statistic. Kept in pkmn: for now rather than widening mo: mid-ingestion; a candidate for promotion to a core mo:Stat via the schema proposal queue once a second universe needs stats."@en .


## Battle stats ##
pkmn:BattleStat a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "BattleStat"@en ;
    skos:definition "A quantity that exists only during battle and changes in stages: accuracy, evasion and critical-hit ratio. No species has a base value for it. Sand Attack lowers accuracy; Focus Energy raises the critical-hit ratio."@en .

pkmn:affectsStat a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( pkmn:Stat pkmn:BattleStat ) ] ;
    rdfs:label "affectsStat"@en ;
    skos:definition "Parent of the nature sub-properties. From an effect node it changes a stat or battle stat by statStages (Swords Dance) or statMultiplier (Choice Band)."@en .

pkmn:blocksStatDrop a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( pkmn:Stat pkmn:BattleStat ) ] ;
    rdfs:label "blocksStatDrop"@en ;
    skos:definition "Other Pokémon cannot lower this stat or battle stat of the holder (Hyper Cutter: Attack). Drops the holder causes itself (Close Combat) still apply."@en .

#################################################################
#  Natures
#################################################################

pkmn:Nature a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "Nature"@en ;
    skos:definition "A nature: raises one stat 10% and lowers another (5 are neutral)."@en .

pkmn:boostsStat a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:affectsStat ;
    rdfs:domain pkmn:Nature ;
    rdfs:range  pkmn:Stat ;
    rdfs:label  "boostsStat"@en .

pkmn:reducesStat a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:affectsStat ;
    rdfs:domain pkmn:Nature ;
    rdfs:range  pkmn:Stat ;
    rdfs:label  "reducesStat"@en .


#################################################################
#  Abilities
#################################################################

pkmn:Ability a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label   "Ability"@en ;
    skos:definition "A passive Pokémon Ability (Static, Levitate, ...)."@en .

pkmn:hasAbility a owl:ObjectProperty ;
    rdfs:domain  pkmn:PokemonSpecies ;
    rdfs:range   pkmn:Ability ;
    rdfs:label   "hasAbility"@en ;
    skos:definition "A species' possible abilities. Whether a slot is the Hidden Ability is an edge property (isHidden) in the LPG realization."@en .

#################################################################
#  Moves
#################################################################

pkmn:MoveDamageClass a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label   "MoveDamageClass"@en ;
    skos:definition "How a move deals (or does not deal) damage."@en .


pkmn:hasDamageClass a owl:ObjectProperty ;
    rdfs:domain  pkmn:Move ;
    rdfs:range   pkmn:MoveDamageClass ;
    rdfs:label   "hasDamageClass"@en .

pkmn:power a owl:DatatypeProperty ;
    rdfs:domain  pkmn:Move ;
    rdfs:range   xsd:integer ;
    rdfs:label   "power"@en ;
    skos:definition "Base power. Absent for status moves."@en .

pkmn:accuracy a owl:DatatypeProperty ;
    rdfs:domain  pkmn:Move ;
    rdfs:range   xsd:integer ;
    rdfs:label   "accuracy"@en ;
    skos:definition "Accuracy percentage (1-100). Absent for moves that bypass accuracy checks."@en .

pkmn:pp a owl:DatatypeProperty ;
    rdfs:domain  pkmn:Move ;
    rdfs:range   xsd:integer ;
    rdfs:label   "pp"@en ;
    skos:definition "Base Power Points (maximum uses)."@en .

## Move numbers ##
pkmn:critStage a owl:DatatypeProperty ; rdfs:domain pkmn:Move ; rdfs:range xsd:integer ; rdfs:label "critStage"@en ;
    skos:definition "Critical-hit stages the move adds to the user's stage while it is used: 1 for a high critical-hit ratio (Stone Edge), 3 for a guaranteed critical hit (Frost Breath). Absent means 0."@en .
pkmn:minHits a owl:DatatypeProperty ; rdfs:domain pkmn:Move ; rdfs:range xsd:integer ; rdfs:label "minHits"@en ;
    skos:definition "Fewest hits of a move that strikes several times in 1 turn (Bullet Seed: 2)."@en .
pkmn:maxHits a owl:DatatypeProperty ; rdfs:domain pkmn:Move ; rdfs:range xsd:integer ; rdfs:label "maxHits"@en ;
    skos:definition "Most hits of a move that strikes several times in 1 turn (Bullet Seed: 5)."@en .

#################################################################
#  Egg groups (breeding compatibility)
#################################################################

pkmn:EggGroup a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label   "EggGroup"@en ;
    skos:definition "A breeding-compatibility grouping: two species can breed if they share an egg group. Cross-cuts the type/species axis, so it is a Concept — not a Taxon and not a social mo:Group."@en .

pkmn:inEggGroup a owl:ObjectProperty ;
    rdfs:domain  pkmn:PokemonSpecies ;
    rdfs:range   pkmn:EggGroup ;
    rdfs:label   "inEggGroup"@en .

# identically-named Type individuals (Bug, Flying, Dragon, Fairy, ...).

#################################################################
#  Battle conditions
#################################################################

pkmn:BattleCondition a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "BattleCondition"@en ;
    skos:definition "An in-battle state affecting a Pokémon or the field."@en .

pkmn:StatusCondition a owl:Class ;
    rdfs:subClassOf pkmn:BattleCondition ;
    rdfs:label "StatusCondition"@en ;
    skos:definition "A non-volatile ailment: at most one at a time, persists through switches."@en .

pkmn:VolatileCondition a owl:Class ;
    rdfs:subClassOf pkmn:BattleCondition ;
    rdfs:label "VolatileCondition"@en ;
    skos:definition "An in-battle volatile state: cleared on switch-out, stackable."@en .

pkmn:FieldCondition a owl:Class ;
    rdfs:subClassOf pkmn:BattleCondition ;
    rdfs:label "FieldCondition"@en ;
    skos:definition "A field-wide battle condition."@en .

pkmn:Weather     a owl:Class ; rdfs:subClassOf pkmn:FieldCondition ; rdfs:label "Weather"@en .
pkmn:Terrain     a owl:Class ; rdfs:subClassOf pkmn:FieldCondition ; rdfs:label "Terrain"@en .
pkmn:EntryHazard a owl:Class ; rdfs:subClassOf pkmn:FieldCondition ; rdfs:label "EntryHazard"@en .
pkmn:FieldEffect a owl:Class ; rdfs:subClassOf pkmn:FieldCondition ; rdfs:label "FieldEffect"@en .

## Condition properties ##

pkmn:modifiesType a owl:ObjectProperty ;
    rdfs:range pkmn:Type ;
    rdfs:label "modifiesType"@en ;
    skos:definition "Parent of the type-multiplier sub-properties."@en .

pkmn:amplifiesType a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:modifiesType ;
    rdfs:label "amplifiesType"@en ;
    skos:definition "Raises damage of a type (e.g. x1.5)."@en .

pkmn:dampensType a owl:ObjectProperty ;
    rdfs:subPropertyOf pkmn:modifiesType ;
    rdfs:label "dampensType"@en ;
    skos:definition "Lowers damage of a type (e.g. x0.5)."@en .

pkmn:inflictsCondition a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( pkmn:StatusCondition pkmn:VolatileCondition ) ] ;
    rdfs:label "inflictsCondition"@en ;
    skos:definition "Applies a status or volatile condition to a Pokémon. Probability lives on the reified effect node."@en .

pkmn:blocksCondition a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( pkmn:StatusCondition pkmn:VolatileCondition pkmn:Weather ) ] ;
    rdfs:label "blocksCondition"@en ;
    skos:definition "Prevents a battle condition from applying."@en .

pkmn:immuneTo a owl:ObjectProperty ;
    rdfs:domain pkmn:Type ;
    rdfs:range  pkmn:StatusCondition ;
    rdfs:label  "immuneTo"@en ;
    skos:definition "A type's inherent status immunity (Fire to Burn, Ice to Freeze, ...)."@en .

#################################################################
#  Items
#################################################################

pkmn:Item a owl:Class ;
    rdfs:subClassOf mo:Object ;
    rdfs:label "Item"@en ;
    skos:definition "An in-game item."@en .

pkmn:Berry    a owl:Class ; rdfs:subClassOf pkmn:Item ; rdfs:label "Berry"@en .
pkmn:Machine  a owl:Class ; rdfs:subClassOf pkmn:Item ; rdfs:label "Machine"@en ;
    skos:definition "A TM, HM or TR in 1 version group. The same number in another version group is another node."@en .
pkmn:HeldItem a owl:Class ; rdfs:subClassOf pkmn:Item ; rdfs:label "HeldItem"@en .

pkmn:teachesMove a owl:ObjectProperty ;
    rdfs:range pkmn:Move ;
    rdfs:label "teachesMove"@en ;
    skos:definition "The move a machine or learnset entry grants."@en .

pkmn:curesCondition a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( pkmn:StatusCondition pkmn:VolatileCondition ) ] ;
    rdfs:label "curesCondition"@en ;
    skos:definition "Removes a status or volatile condition from a Pokémon."@en .

pkmn:restoresStat a owl:ObjectProperty ;
    rdfs:range pkmn:Stat ;
    rdfs:label "restoresStat"@en ;
    skos:definition "Restores HP or PP of the effect's recipient. The size is amount (fixed points: Potion) or hpChange (a share: Leftovers) on the same effect node."@en .

## Item effects ##

pkmn:ItemEffect a owl:Class ;
    rdfs:subClassOf mo:Concept ;
    rdfs:label "ItemEffect"@en ;
    skos:definition "A reified battle effect of an item, carrying its trigger and magnitude."@en .

pkmn:category         a owl:DatatypeProperty ; rdfs:domain pkmn:Item ; rdfs:range xsd:string  ; rdfs:label "category"@en .
pkmn:price            a owl:DatatypeProperty ; rdfs:domain pkmn:Item ; rdfs:range xsd:integer ; rdfs:label "price"@en .
pkmn:isConsumable     a owl:DatatypeProperty ; rdfs:domain pkmn:Item ; rdfs:range xsd:boolean ; rdfs:label "isConsumable"@en .
pkmn:machineNumber    a owl:DatatypeProperty ; rdfs:domain pkmn:Machine ; rdfs:range xsd:integer ; rdfs:label "machineNumber"@en .
pkmn:machineKind      a owl:DatatypeProperty ; rdfs:domain pkmn:Machine ; rdfs:range xsd:string ; rdfs:label "machineKind"@en ; skos:definition "TM, HM, or TR."@en .
pkmn:isReusable       a owl:DatatypeProperty ; rdfs:domain pkmn:Machine ; rdfs:range xsd:boolean ; rdfs:label "isReusable"@en .
pkmn:flavour          a owl:DatatypeProperty ; rdfs:domain pkmn:Berry ; rdfs:range xsd:string ; rdfs:label "flavour"@en .
pkmn:hpThreshold      a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "hpThreshold"@en ;
    skos:definition "Fraction of max HP (0 to 1). With trigger low_hp the effect fires at it; otherwise the effect applies only at or below it."@en .
pkmn:amount           a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "amount"@en ;
    skos:definition "Fixed number of HP or PP points restored."@en .

## HP ##
pkmn:hpChange a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "hpChange"@en ;
    skos:definition "Signed share of HP the recipient (target) gains or loses, as a fraction of hpBasis: 0.25 heals a quarter (Sitrus Berry), -0.1667 removes a sixth (Rocky Helmet). A positive value comes with restoresStat to HP on the same effect node."@en .
pkmn:hpBasis a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "hpBasis"@en ;
    skos:definition "What hpChange is a share of: max_hp (the recipient's maximum HP: Leftovers), current_hp (the recipient's current HP: Super Fang) or damage_dealt (the damage the move or holder just dealt: Giga Drain, Brave Bird)."@en .

#################################################################
#  Meta: generations, versions, mechanics
#################################################################

pkmn:Generation         a owl:Class ; rdfs:subClassOf mo:Series ; rdfs:label "Generation"@en .
pkmn:VersionGroup       a owl:Class ; rdfs:subClassOf mo:Work ; rdfs:label "VersionGroup"@en ;
    skos:definition "A set of games sharing one data set (e.g. Diamond-Pearl)."@en .
pkmn:Version            a owl:Class ; rdfs:subClassOf mo:Work ; rdfs:label "Version"@en .
pkmn:GenerationMechanic a owl:Class ; rdfs:subClassOf mo:System ; rdfs:label "GenerationMechanic"@en ;
    skos:definition "A generation-defining battle mechanic (Mega Evolution, Dynamax, ...)."@en .

pkmn:introducedIn a owl:ObjectProperty ;
    rdfs:range pkmn:Generation ;
    rdfs:label "introducedIn"@en ;
    skos:definition "The generation a species, move, ability, mechanic or region debuted in."@en .

pkmn:appliesTo a owl:ObjectProperty ;
    rdfs:domain pkmn:GenerationMechanic ;
    rdfs:range  pkmn:PokemonSpecies ;
    rdfs:label  "appliesTo"@en ;
    skos:definition "Species eligible for a species-specific mechanic (Mega, Gigantamax)."@en .

#################################################################
#  Moves: flags, effects, learnset
#################################################################

pkmn:MoveFlag a owl:Class ; rdfs:subClassOf mo:Concept ; rdfs:label "MoveFlag"@en ;
    skos:definition "A move tag gating interactions (contact, sound, punch, ...)."@en .

pkmn:MoveEffect a owl:Class ; rdfs:subClassOf mo:Concept ; rdfs:label "MoveEffect"@en ;
    skos:definition "A reified secondary effect of a move; carries probability and magnitude."@en .

pkmn:LearnsetEntry a owl:Class ; rdfs:subClassOf mo:Concept ; rdfs:label "LearnsetEntry"@en ;
    skos:definition "A reified (species, move, version group, method, level) learn fact."@en .

pkmn:hasFlag a owl:ObjectProperty ;
    rdfs:domain pkmn:Move ;
    rdfs:range  pkmn:MoveFlag ;
    rdfs:label  "hasFlag"@en .

pkmn:setsField a owl:ObjectProperty ;
    rdfs:range pkmn:FieldCondition ;
    rdfs:label "setsField"@en ;
    skos:definition "Sets a field condition (weather, terrain, hazard, field effect)."@en .

pkmn:removesField a owl:ObjectProperty ;
    rdfs:range pkmn:FieldCondition ;
    rdfs:label "removesField"@en ;
    skos:definition "Removes a field condition."@en .

pkmn:hasLearnsetEntry a owl:ObjectProperty ;
    rdfs:domain pkmn:PokemonSpecies ;
    rdfs:range  pkmn:LearnsetEntry ;
    rdfs:label  "hasLearnsetEntry"@en .

pkmn:canLearn a owl:ObjectProperty ;
    rdfs:domain pkmn:PokemonSpecies ;
    rdfs:range  pkmn:Move ;
    rdfs:label  "canLearn"@en ;
    skos:definition "Shortcut of hasLearnsetEntry + teachesMove over entries in the snapshot version group (Scarlet/Violet). Learnability in other version groups goes through LearnsetEntry."@en .

pkmn:inVersionGroup a owl:ObjectProperty ;
    rdfs:range  pkmn:VersionGroup ;
    rdfs:label  "inVersionGroup"@en ;
    skos:definition "The version group a learnset entry or a machine belongs to."@en .

pkmn:viaMachine a owl:ObjectProperty ;
    rdfs:domain pkmn:LearnsetEntry ;
    rdfs:range  pkmn:Machine ;
    rdfs:label  "viaMachine"@en .

pkmn:viaParent a owl:ObjectProperty ;
    rdfs:domain pkmn:LearnsetEntry ;
    rdfs:range  pkmn:PokemonSpecies ;
    rdfs:label  "viaParent"@en ;
    skos:definition "The parent species of an egg move."@en .

pkmn:priority   a owl:DatatypeProperty ; rdfs:domain pkmn:Move ; rdfs:range xsd:integer ; rdfs:label "priority"@en .
pkmn:target     a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "target"@en ; skos:definition "On a move, the source targeting code in snake_case (any_adjacent, ...); on an effect, the recipient (self, foe, field)."@en .
pkmn:effectText a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "effectText"@en ; skos:definition "The PokeAPI English short effect of a move, ability or item. Effect nodes do not carry it."@en .

pkmn:probability a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "probability"@en ; skos:definition "Chance (0-100) an effect triggers."@en .
pkmn:statStages  a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "statStages"@en ; skos:definition "Signed stat-stage change (-6..+6)."@en .

## Multipliers ##
pkmn:statMultiplier a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "statMultiplier"@en ;
    skos:definition "Factor on the stat or battle stat that affectsStat points at (Choice Band: Attack x1.5; Compound Eyes: accuracy x1.3)."@en .
pkmn:powerMultiplier a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "powerMultiplier"@en ;
    skos:definition "Factor on the base power of the moves that pass the effect's filters (Charcoal: Fire moves x1.2; Iron Fist: punch moves x1.2; Weather Ball in rain: x2)."@en .
pkmn:damageMultiplier a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "damageMultiplier"@en ;
    skos:definition "Factor on the final damage of the moves that pass the effect's filters (Life Orb: the holder's moves x1.3; Fluffy: contact moves that hit the holder x0.5)."@en .

pkmn:trigger     a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "trigger"@en ; skos:definition "When an ability or item effect fires: switch_in, switch_out (holder leaves battle), on_attack (holder uses a move), on_hit (holder is hit), low_hp, end_of_turn, passive."@en .

pkmn:method a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "method"@en ; skos:definition "Learnset method (level, machine, egg, tutor, evolution, special (event and Wild Tera moves)) or PokeAPI encounter method (walk, surf, old-rod, headbutt, gift, ...)."@en .
pkmn:level  a owl:DatatypeProperty ; rdfs:domain pkmn:LearnsetEntry ; rdfs:range xsd:integer ; rdfs:label "level"@en .

#################################################################
#  Abilities: effects
#################################################################

pkmn:AbilityEffect a owl:Class ; rdfs:subClassOf mo:Concept ; rdfs:label "AbilityEffect"@en ;
    skos:definition "A reified effect of an ability."@en .

pkmn:hasEffect a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( pkmn:MoveEffect pkmn:AbilityEffect pkmn:ItemEffect ) ] ;
    rdfs:label "hasEffect"@en ;
    skos:definition "Links a move, ability or item to one of its reified effects."@en .

pkmn:triggeredBy a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( pkmn:MoveFlag pkmn:MoveDamageClass pkmn:Type pkmn:FieldCondition ) ] ;
    rdfs:label "triggeredBy"@en ;
    skos:definition "What activates an effect. A move flag, damage class or type filters the move involved, and trigger gives the direction (Static: on_hit + contact). A field condition fires the effect while it is active (Electric Seed)."@en .

pkmn:hasOverworldEffect a owl:DatatypeProperty ; rdfs:domain pkmn:Ability ; rdfs:range xsd:boolean ; rdfs:label "hasOverworldEffect"@en .

#################################################################
#  Evolution and forms
#################################################################

pkmn:Evolution a owl:Class ; rdfs:subClassOf mo:Concept ; rdfs:label "Evolution"@en ;
    skos:definition "A reified evolution: from-species, to-species, and its conditions."@en .

pkmn:MegaEvolution a owl:Class ; rdfs:subClassOf mo:Concept ; rdfs:label "MegaEvolution"@en ;
    skos:definition "A reified Mega Evolution linking a base species, its mega form, and the Mega Stone. Not an Evolution: reversible and battle-only."@en .

pkmn:fromSpecies a owl:ObjectProperty ; rdfs:domain pkmn:Evolution ; rdfs:range pkmn:PokemonSpecies ; rdfs:label "fromSpecies"@en .
pkmn:toSpecies   a owl:ObjectProperty ; rdfs:domain pkmn:Evolution ; rdfs:range pkmn:PokemonSpecies ; rdfs:label "toSpecies"@en .

pkmn:requires a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( pkmn:Item pkmn:Move mo:Location pkmn:PokemonSpecies pkmn:Type ) ] ;
    rdfs:label "requires"@en ;
    skos:definition "A required object of an evolution or mega evolution."@en ;
    rdfs:comment "In Neo4j every REQUIRES edge carries role: use, hold, knownMove, knownMoveType, atLocation, partySpecies, partyType, tradedFor."@en .

pkmn:baseSpecies a owl:ObjectProperty ; rdfs:domain pkmn:MegaEvolution ; rdfs:range pkmn:PokemonSpecies ; rdfs:label "baseSpecies"@en .
pkmn:megaForm    a owl:ObjectProperty ; rdfs:domain pkmn:MegaEvolution ; rdfs:range pkmn:PokemonSpecies ; rdfs:label "megaForm"@en .

pkmn:evolvesTo a owl:ObjectProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range pkmn:PokemonSpecies ; rdfs:label "evolvesTo"@en ;
    skos:definition "Shortcut of the Evolution reification for chain traversal."@en .
pkmn:hasForm a owl:ObjectProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range pkmn:PokemonSpecies ; rdfs:label "hasForm"@en ;
    skos:definition "A battle-distinct alternate form (regional, alternate, or battle-only)."@en .

pkmn:evoTrigger a owl:DatatypeProperty ; rdfs:domain pkmn:Evolution ; rdfs:range xsd:string  ; rdfs:label "evoTrigger"@en ; skos:definition "level, item, trade, friendship, ..."@en .
pkmn:minLevel   a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "minLevel"@en ; skos:definition "Minimum level of an evolution or an encounter."@en .
pkmn:timeOfDay  a owl:DatatypeProperty ; rdfs:domain pkmn:Evolution ; rdfs:range xsd:string  ; rdfs:label "timeOfDay"@en .
pkmn:gender     a owl:DatatypeProperty ; rdfs:domain pkmn:Evolution ; rdfs:range xsd:string  ; rdfs:label "gender"@en .
pkmn:condition  a owl:DatatypeProperty ; rdfs:domain pkmn:Evolution ; rdfs:range xsd:string  ; rdfs:label "condition"@en ; skos:definition "Residual free-text evolution condition."@en .

#################################################################
#  Species groups
#################################################################

pkmn:SpeciesGroup a owl:Class ; rdfs:subClassOf mo:Group ; rdfs:label "SpeciesGroup"@en ;
    skos:definition "A thematic grouping of species (legendary duo/trio, starter trio)."@en .
pkmn:LegendaryGroup a owl:Class ; rdfs:subClassOf pkmn:SpeciesGroup ; rdfs:label "LegendaryGroup"@en .
pkmn:StarterTrio    a owl:Class ; rdfs:subClassOf pkmn:SpeciesGroup ; rdfs:label "StarterTrio"@en .

pkmn:inGroup a owl:ObjectProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range pkmn:SpeciesGroup ; rdfs:label "inGroup"@en .


#################################################################
#  Encounters and locations
#################################################################

pkmn:LocationArea a owl:Class ; rdfs:subClassOf mo:Location ; rdfs:label "LocationArea"@en ;
    skos:definition "A data-only subdivision of a location (a floor, an exterior, a Safari Zone sector) with no identity outside its parent."@en .

pkmn:Encounter a owl:Class ; rdfs:subClassOf mo:Concept ; rdfs:label "Encounter"@en ;
    skos:definition "A reified wild-encounter fact: a species at a location in a version, with method, conditions, level range and chance."@en .

pkmn:hasEncounter a owl:ObjectProperty ; rdfs:domain pkmn:PokemonSpecies ; rdfs:range pkmn:Encounter ; rdfs:label "hasEncounter"@en ;
    skos:definition "Links a species to one of its wild encounters."@en .
pkmn:atLocation   a owl:ObjectProperty ; rdfs:domain pkmn:Encounter ; rdfs:range mo:Location ; rdfs:label "atLocation"@en ;
    skos:definition "Where an encounter happens: the location area when one exists, else the location."@en .
pkmn:inVersion    a owl:ObjectProperty ; rdfs:domain pkmn:Encounter ; rdfs:range pkmn:Version ; rdfs:label "inVersion"@en ;
    skos:definition "The game version an encounter belongs to."@en .

pkmn:conditions a owl:DatatypeProperty ; rdfs:domain pkmn:Encounter ; rdfs:range xsd:string ; rdfs:label "conditions"@en ;
    skos:definition "PokeAPI encounter condition value (time-night, season-spring, swarm-yes). Repeated; absent when unconditional."@en .
pkmn:maxLevel   a owl:DatatypeProperty ; rdfs:domain pkmn:Encounter ; rdfs:range xsd:integer ; rdfs:label "maxLevel"@en .
pkmn:chance     a owl:DatatypeProperty ; rdfs:domain pkmn:Encounter ; rdfs:range xsd:integer ; rdfs:label "chance"@en ;
    skos:definition "Encounter slot rate in %."@en .
