## Volatile conditions ##
# Names are the in-game status names; mo:aliases keeps the move-derived name.
pkmn:confused         a pkmn:VolatileCondition ; rdfs:label "Confused"@en ; mo:aliases "Confusion"@en .
pkmn:flinch           a pkmn:VolatileCondition ; rdfs:label "Flinch"@en .
pkmn:infatuated       a pkmn:VolatileCondition ; rdfs:label "Infatuated"@en ; mo:aliases "Infatuation"@en .
pkmn:taunted          a pkmn:VolatileCondition ; rdfs:label "Taunted"@en ; mo:aliases "Taunt"@en .
pkmn:encore           a pkmn:VolatileCondition ; rdfs:label "Encore"@en .
pkmn:moveDisabled     a pkmn:VolatileCondition ; rdfs:label "Move Disabled"@en ; mo:aliases "Disable"@en .
pkmn:unableToRepeat   a pkmn:VolatileCondition ; rdfs:label "Unable to Repeat"@en ; mo:aliases "Torment"@en .
pkmn:healingPrevented a pkmn:VolatileCondition ; rdfs:label "Healing Prevented"@en ; mo:aliases "Heal Block"@en .
pkmn:leechSeeded      a pkmn:VolatileCondition ; rdfs:label "Leech Seeded"@en ; mo:aliases "Leech Seed"@en .
pkmn:volatileDrowsy   a pkmn:VolatileCondition ; rdfs:label "Drowsy"@en ; mo:aliases "Yawn"@en .
pkmn:cantEscape       a pkmn:VolatileCondition ; rdfs:label "Can't Escape"@en ; mo:aliases "Trapped"@en .
pkmn:bound            a pkmn:VolatileCondition ; rdfs:label "Bound"@en .
pkmn:noAbility        a pkmn:VolatileCondition ; rdfs:label "No Ability"@en .
pkmn:substitute       a pkmn:VolatileCondition ; rdfs:label "Substitute"@en .
pkmn:telekinesis      a pkmn:VolatileCondition ; rdfs:label "Telekinesis"@en .
pkmn:magnetRise       a pkmn:VolatileCondition ; rdfs:label "Magnet Rise"@en .
pkmn:concealed        a pkmn:VolatileCondition ; rdfs:label "Concealed"@en .
pkmn:skyHigh          a pkmn:VolatileCondition ; rdfs:label "Sky-High"@en .
pkmn:submerged        a pkmn:VolatileCondition ; rdfs:label "Submerged"@en .
pkmn:underground      a pkmn:VolatileCondition ; rdfs:label "Underground"@en .

## Weather ##
pkmn:rain                   a pkmn:Weather ; rdfs:label "Rain"@en ; pkmn:amplifiesType pkmn:Water ; pkmn:dampensType pkmn:Fire .
pkmn:harshSunlight          a pkmn:Weather ; rdfs:label "Harsh Sunlight"@en ; pkmn:amplifiesType pkmn:Fire ; pkmn:dampensType pkmn:Water .
pkmn:sandstorm              a pkmn:Weather ; rdfs:label "Sandstorm"@en .
pkmn:hail                   a pkmn:Weather ; rdfs:label "Hail"@en .
pkmn:snow                   a pkmn:Weather ; rdfs:label "Snow"@en .
pkmn:fog                    a pkmn:Weather ; rdfs:label "Fog"@en .
pkmn:extremelyHarshSunlight a pkmn:Weather ; rdfs:label "Extremely Harsh Sunlight"@en ; pkmn:amplifiesType pkmn:Fire .
pkmn:heavyRain              a pkmn:Weather ; rdfs:label "Heavy Rain"@en ; pkmn:amplifiesType pkmn:Water .
pkmn:strongWinds            a pkmn:Weather ; rdfs:label "Strong Winds"@en .

## Terrain ##
pkmn:electricTerrain a pkmn:Terrain ; rdfs:label "Electric Terrain"@en ; pkmn:amplifiesType pkmn:Electric ; pkmn:introducedIn pkmn:gen6 .
pkmn:grassyTerrain   a pkmn:Terrain ; rdfs:label "Grassy Terrain"@en ; pkmn:amplifiesType pkmn:Grass ; pkmn:introducedIn pkmn:gen6 .
pkmn:mistyTerrain    a pkmn:Terrain ; rdfs:label "Misty Terrain"@en ; pkmn:dampensType pkmn:Dragon ; pkmn:introducedIn pkmn:gen6 .
pkmn:psychicTerrain  a pkmn:Terrain ; rdfs:label "Psychic Terrain"@en ; pkmn:amplifiesType pkmn:Psychic ; pkmn:introducedIn pkmn:gen7 .

