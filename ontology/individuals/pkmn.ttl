pkmn:eggGroupMonster   a pkmn:EggGroup ; rdfs:label "Monster"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupWater1    a pkmn:EggGroup ; rdfs:label "Water 1"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupBug       a pkmn:EggGroup ; rdfs:label "Bug"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupFlying    a pkmn:EggGroup ; rdfs:label "Flying"@en ; pkmn:introducedIn pkmn:gen2 .
