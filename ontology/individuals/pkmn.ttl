pkmn:eggGroupFairy     a pkmn:EggGroup ; rdfs:label "Fairy"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupGrass     a pkmn:EggGroup ; rdfs:label "Grass"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupHumanLike a pkmn:EggGroup ; rdfs:label "Human-Like"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupMineral   a pkmn:EggGroup ; rdfs:label "Mineral"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupDragon    a pkmn:EggGroup ; rdfs:label "Dragon"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupDitto     a pkmn:EggGroup ; rdfs:label "Ditto"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupNoEggs    a pkmn:EggGroup ; rdfs:label "No Eggs Discovered"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupWater2    a pkmn:EggGroup ; rdfs:label "Water 2"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupWater3    a pkmn:EggGroup ; rdfs:label "Water 3"@en ; pkmn:introducedIn pkmn:gen2 .
pkmn:eggGroupAmorphous a pkmn:EggGroup ; rdfs:label "Amorphous"@en ; pkmn:introducedIn pkmn:gen2 .

