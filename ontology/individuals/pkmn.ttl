pkmn:calm    a pkmn:Nature ; rdfs:label "Calm"@en ; pkmn:boostsStat pkmn:specialDefense ; pkmn:reducesStat pkmn:attack ; pkmn:introducedIn pkmn:gen3 .
pkmn:gentle  a pkmn:Nature ; rdfs:label "Gentle"@en ; pkmn:boostsStat pkmn:specialDefense ; pkmn:reducesStat pkmn:defense ; pkmn:introducedIn pkmn:gen3 .
pkmn:sassy   a pkmn:Nature ; rdfs:label "Sassy"@en ; pkmn:boostsStat pkmn:specialDefense ; pkmn:reducesStat pkmn:speed ; pkmn:introducedIn pkmn:gen3 .
pkmn:careful a pkmn:Nature ; rdfs:label "Careful"@en ; pkmn:boostsStat pkmn:specialDefense ; pkmn:reducesStat pkmn:specialAttack ; pkmn:introducedIn pkmn:gen3 .
