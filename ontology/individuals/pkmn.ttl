pkmn:impish  a pkmn:Nature ; rdfs:label "Impish"@en ; pkmn:boostsStat pkmn:defense ; pkmn:reducesStat pkmn:specialAttack ; pkmn:introducedIn pkmn:gen3 .
pkmn:lax     a pkmn:Nature ; rdfs:label "Lax"@en ; pkmn:boostsStat pkmn:defense ; pkmn:reducesStat pkmn:specialDefense ; pkmn:introducedIn pkmn:gen3 .
pkmn:timid   a pkmn:Nature ; rdfs:label "Timid"@en ; pkmn:boostsStat pkmn:speed ; pkmn:reducesStat pkmn:attack ; pkmn:introducedIn pkmn:gen3 .
pkmn:hasty   a pkmn:Nature ; rdfs:label "Hasty"@en ; pkmn:boostsStat pkmn:speed ; pkmn:reducesStat pkmn:defense ; pkmn:introducedIn pkmn:gen3 .
pkmn:serious a pkmn:Nature ; rdfs:label "Serious"@en ; pkmn:introducedIn pkmn:gen3 .
pkmn:jolly   a pkmn:Nature ; rdfs:label "Jolly"@en ; pkmn:boostsStat pkmn:speed ; pkmn:reducesStat pkmn:specialAttack ; pkmn:introducedIn pkmn:gen3 .
pkmn:naive   a pkmn:Nature ; rdfs:label "Naive"@en ; pkmn:boostsStat pkmn:speed ; pkmn:reducesStat pkmn:specialDefense ; pkmn:introducedIn pkmn:gen3 .
pkmn:modest  a pkmn:Nature ; rdfs:label "Modest"@en ; pkmn:boostsStat pkmn:specialAttack ; pkmn:reducesStat pkmn:attack ; pkmn:introducedIn pkmn:gen3 .
pkmn:mild    a pkmn:Nature ; rdfs:label "Mild"@en ; pkmn:boostsStat pkmn:specialAttack ; pkmn:reducesStat pkmn:defense ; pkmn:introducedIn pkmn:gen3 .
pkmn:quiet   a pkmn:Nature ; rdfs:label "Quiet"@en ; pkmn:boostsStat pkmn:specialAttack ; pkmn:reducesStat pkmn:speed ; pkmn:introducedIn pkmn:gen3 .
pkmn:bashful a pkmn:Nature ; rdfs:label "Bashful"@en ; pkmn:introducedIn pkmn:gen3 .
