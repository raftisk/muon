@prefix pkmn: <https://muon.dev/ns/pkmn#> .
@prefix pkmn-shape: <https://muon.dev/ns/pkmn-shapes#> .
@prefix mo: <https://muon.dev/ns/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Shapes for the pkmn universe, validated against the projection of a Neo4j
# write transaction. Sections follow ontology/universes/pkmn.ttl. The ttl
# sections without rules (base stats, natures, abilities, egg groups, battle
# conditions, species groups) have no banner here.

<https://muon.dev/ns/pkmn-shapes> a owl:Ontology ;
    dcterms:title   "muon: Pokémon SHACL shapes"@en ;
    owl:versionInfo "0.1.0" ;
    owl:imports     <https://muon.dev/ns/pkmn> ;
    sh:declare [ sh:prefix "pkmn" ; sh:namespace "https://muon.dev/ns/pkmn#"^^xsd:anyURI ] ,
               [ sh:prefix "mo" ; sh:namespace "https://muon.dev/ns/core#"^^xsd:anyURI ] ,
               [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] .

#################################################################
#  Cross-cutting: node keys and edge typing
#################################################################

# Node keys. `pkmn:id` is the projection of the Neo4j node key, which the ttl
# does not declare. Reified nodes build their id from their participants and
# join the segments with a colon.
pkmn-shape:L2_NodeKey a sh:NodeShape ;
    sh:name "L2" ;
    sh:message "Node has no valid pkmn:id: exactly 1 lowercase hyphenated slug, with colon-separated segments for reified nodes."@en ;
    sh:severity sh:Violation ;
    sh:targetClass mo:Entity , mo:Meta ;
    sh:property [
        sh:path pkmn:id ;
        sh:name "L2" ;
        sh:message "pkmn:id must appear exactly once and match a lowercase hyphenated slug, with colon-separated segments for reified nodes."@en ;
        sh:severity sh:Violation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-z0-9]+(-[a-z0-9]+)*(:[a-z0-9]+(-[a-z0-9]+)*)*$"
    ] .

# Edge typing. Both shapes read rdfs:range and rdfs:domain from the T-Box, so
# they cannot drift from the ttl. A property with no declared range or domain
# is not checked. A union in owl:unionOf accepts any of its members.
pkmn-shape:T1_EdgeRange a sh:NodeShape ;
    sh:name "T1" ;
    sh:message "Edge target is not an instance of the ttl rdfs:range of the property."@en ;
    sh:severity sh:Violation ;
    sh:targetClass mo:Entity , mo:Meta ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Edge {?path} from {$this} to {?value} does not match the rdfs:range in the ttl."@en ;
        sh:prefixes <https://muon.dev/ns/pkmn-shapes> ;
        sh:select """
            SELECT $this ?path ?value WHERE {
                $this ?path ?value .
                ?path rdfs:range ?range .
                FILTER isIRI(?value)
                FILTER NOT EXISTS {
                    ?range (owl:unionOf/rdf:rest*/rdf:first)? ?allowed .
                    ?value rdf:type/rdfs:subClassOf* ?allowed .
                }
            }
        """
    ] .

pkmn-shape:T1_EdgeDomain a sh:NodeShape ;
    sh:name "T1" ;
    sh:message "Edge source is not an instance of the ttl rdfs:domain of the property."@en ;
    sh:severity sh:Violation ;
    sh:targetClass mo:Entity , mo:Meta ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Edge {?path} from {$this} to {?value} does not match the rdfs:domain in the ttl."@en ;
        sh:prefixes <https://muon.dev/ns/pkmn-shapes> ;
        sh:select """
            SELECT $this ?path ?value WHERE {
                $this ?path ?value .
                ?path rdfs:domain ?domain .
                FILTER NOT EXISTS {
                    ?domain (owl:unionOf/rdf:rest*/rdf:first)? ?allowed .
                    $this rdf:type/rdfs:subClassOf* ?allowed .
                }
            }
        """
    ] .

